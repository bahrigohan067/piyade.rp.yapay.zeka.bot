# ============================================================
# PİYADE ROLEPLAY YAPAY ZEKA DESTEK BOTU YAPILANDIRMASI
# ============================================================

# 1. Discord Bot Tokeni (Zorunlu)
# Discord Developer Portal (https://discord.com/developers/applications) -> Bot sekmesinden alınız.
TOKEN_AL_BOT=BURAYA_DISCORD_BOT_TOKENINIZI_YAZIN

# 2. Google Gemini API Anahtarı (Yapay Zeka Yanıtları İçin)
# Google AI Studio (https://aistudio.google.com/app/apikey) adresinden ücretsiz olarak alabilirsiniz.
GEMINI_API_KEY=BURAYA_GEMINI_API_KEYINIZI_YAZIN

# 3. Gemini Modeli (Varsayılan: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 4. Sunucu ID (Piyade Roleplay)
GUILD_ID=1529545898294509589

# 5. Ticket Yetkilisi Rol ID (Bildirimler için)
TICKET_YETKILI_ROL_ID=1553333289798869032
